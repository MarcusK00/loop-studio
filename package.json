{
  "name": "loop-studio",
  "version": "2.0.0",
  "description": "Deterministic browser capture and verification CLI for source-grounded, dual-theme README/PR animations and external loop auditing.",
  "type": "module",
  "bin": {
    "loop": "./tool/bin/loop.js"
  },
  "main": "./tool/index.js",
  "exports": {
    ".": "./tool/index.js",
    "./kit": "./tool/lib/loop-kit.js"
  },
  "scripts": {
    "loop": "node ./tool/bin/loop.js",
    "test": "node ./tool/test/run-evals.js",
    "doctor": "node ./tool/bin/loop.js doctor"
  },
  "keywords": [
    "agent-skill",
    "antigravity-plugin",
    "claude-code-plugin",
    "gemini-extension",
    "readme-demo",
    "seamless-loop",
    "wcag-contrast",
    "doc-sync",
    "gif",
    "webp"
  ],
  "author": "Marcusk00",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarcusK00/loop-studio.git"
  },
  "homepage": "https://github.com/MarcusK00/loop-studio#readme",
  "engines": {
    "node": ">=18.0.0"
  }
}
